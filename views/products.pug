extends layout

block content
  h1.inventory-title Current Inventory
  p.inventory-subtitle Explore our certified pre-owned selection.

  div.inventory-grid
    each car in inventory
      div.car-card

        //- Placeholder for future images
        div.image-placeholder
          span No Image Available
        
        div.car-card-content
          h2.car-model #{car.model}
          div.car-meta
            span.price $#{car.price.toLocaleString()}
            span.mileage #{car.mileage.toLocaleString()} mi
          
          a.btn-details(href=`/products/${car.mileage}`) View Details