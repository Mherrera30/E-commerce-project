extends layout

block content
  h1 Your Shopping Cart
  p (Static Mockup)
  
  table
    tr
      th Item
      th Quantity
      th Price
    tr
      td 2023 Porsche GT3 RS
      td 1
      td $125,000

  div.cart-summary
    p Subtotal: #[span $125,000]
    p Sales Tax (Estimate): #[span $12,000]
    p Fees and Registration: #[span $1,000]
    hr
    h3 Total: $138,000