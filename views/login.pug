extends layout

block content
  .login-page
    h2 Access Your Account
    
    //- FEEDBACK ALERTS
    if error
      p.alert-error #{error}
    if success
      p.alert-success #{success}

    form(action="/login" method="POST" id="authForm")
      .input-box
        label Username
        input(type="text" name="username" required)
      .input-box
        label Password
        input(type="password" name="password" required)
      button.btn(type="submit") Login
    
    .login-divider
    p Don't have an account?
    button.btn-secondary(type="submit" form="authForm" formaction="/register") Create Account